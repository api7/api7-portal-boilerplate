{
  "name": "api7ee-developer-portal",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "moon run site:dev",
    "build": "moon run site:build",
    "tsc": "moon run site:tsc",
    "lint": "moon run site:lint",
    "lint:fix": "cd apps/site && pnpm lint --fix && moon run site:tsc",
    "preview": "cd apps/site && pnpm preview",
    "e2e": "pnpm -F site-e2e --workspace-root e2e",
    "e2e:ui": "cd apps/site-e2e && pnpm e2e:ui",
    "e2e:headed": "cd apps/site-e2e && pnpm e2e:headed"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.4.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
