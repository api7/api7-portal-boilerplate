{
  "name": "api7ee-developer-portal",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "moon run site:dev",
    "build": "moon run site:build",
    "tsc": "moon run site:tsc",
    "lint": "moon run site:lint",
    "lint:fix": "cd apps/site && pnpm lint --fix && moon run site:tsc",
    "preview": "cd apps/site && pnpm preview",
    "e2e": "pnpm -F site-e2e --workspace-root e2e",
    "e2e:ui": "cd apps/site-e2e && pnpm e2e:ui",
    "e2e:headed": "cd apps/site-e2e && pnpm e2e:headed"
  },
  "dependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.5.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "catalog:",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.8",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
