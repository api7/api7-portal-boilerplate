{
  "name": "api7ee-developer-portal",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "moon run site:dev",
    "build": "moon run site:build",
    "tsc": "moon run site:tsc",
    "lint": "moon run site:lint",
    "lint:fix": "cd apps/site && pnpm lint --fix && moon run site:tsc",
    "preview": "cd apps/site && pnpm preview",
    "e2e": "pnpm -F site-e2e --workspace-root e2e",
    "e2e:ui": "cd apps/site-e2e && pnpm e2e:ui",
    "e2e:headed": "cd apps/site-e2e && pnpm e2e:headed"
  },
  "dependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.5.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "catalog:",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.8",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
